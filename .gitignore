# ==============================
# Unity Minimal Clean GitIgnore
# ==============================

# Ignore everything by default
/*

!.gitignore

# Allow only these root folders
!/Assets
!/ProjectSettings
!/Packages

# Allow their contents
!/Assets/**
!/ProjectSettings/**
!/Packages/**


# ==============================
# Explicitly ignore generated folders
# ==============================

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
MemoryCaptures/
Recordings/
Artifacts/

# ==============================
# IDE
# ==============================

.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ==============================
# OS
# ==============================

.DS_Store
Thumbs.db

# ==============================
# Crash Reports
# ==============================

sysinfo.txt
